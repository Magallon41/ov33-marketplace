rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones de Seguridad y Autorización ────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'jesusmagallon04@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if true;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Órdenes (ov33_orders y orders) ─────────────────────────────────────────
    match /ov33_orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ── Productos (ov33_products y products) ──────────────────────────────────
    match /ov33_products/{productId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    // ── Categorías (ov33_categories y categories) ─────────────────────────────
    match /ov33_categories/{catId} {
      allow read, write: if true;
    }

    match /categories/{catId} {
      allow read, write: if true;
    }

    // ── Mayoristas / Leads B2B ────────────────────────────────────────────────
    match /wholesale_leads/{leadId} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    // ── Suscriptores al Newsletter ────────────────────────────────────────────
    match /newsletter_subscribers/{subId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ── Registro de Errores ────────────────────────────────────────────────────
    match /unhandled_errors/{errorId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Diagnóstico del Sistema ────────────────────────────────────────────────
    match /system_diagnostics/{docId} {
      allow read, write, delete: if true;
    }
  }
}
