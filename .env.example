# Configuración de Entorno para OV33 MARKETPLACE
# Copia este archivo como .env y coloca tus credenciales

# Firebase (Base de datos Firestore, Auth y Storage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Subida de imágenes a ImgBB
VITE_IMGBB_API_KEY=

# Mercado Pago (Pagos en línea y Checkout Pro)
MERCADO_PAGO_ACCESS_TOKEN=
VITE_MERCADOPAGO_PUBLIC_KEY=

# Envia.com (Cotizaciones de paqueterías, guías y rastreo)
ENVIA_TOKEN=
VITE_ENVIA_TOKEN=

# WhatsApp de atención comercial y B2B (formato internacional sin signos: ej. 5213300000000)
VITE_WHATSAPP_NUMBER=
